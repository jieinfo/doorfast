{
  "luci-app-doorfast": {
    "description": "Read Doorfast status and manage Doorfast configuration",
    "read": {
      "uci": ["doorfast", "doorfast-automation", "doorfast-events"],
      "ubus": {
        "doorfast": ["status", "stations", "station_candidates", "logs"]
      }
    },
    "write": {
      "uci": ["doorfast", "doorfast-automation", "doorfast-events"],
      "ubus": {
        "doorfast": ["station_scan", "media_credentials"]
      }
    }
  }
}
