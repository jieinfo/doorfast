#!/bin/sh /etc/rc.common

USE_PROCD=1
START=90

EVENT_DIR=/var/run/doorfast

ensure_event_runtime() {
	# Keep this idempotent for restarts and package upgrades.
	if ! group_exists doorfast; then
		group_add_next doorfast >/dev/null
		group_exists doorfast || return 1
	fi
	mkdir -p "$EVENT_DIR" &&
		chown root:doorfast "$EVENT_DIR" &&
		chmod 0750 "$EVENT_DIR"
}

load_auto_elevator() {
	config_load doorfast-automation
	config_get call_elev main call_elev
	case "$call_elev" in
		0|1) return 0 ;;
	esac

	config_load doorfast
	config_get_bool call_elev main call_elev 0
	uci -q set "doorfast-automation.main.call_elev=$call_elev" &&
		uci -q commit doorfast-automation
}

start_service() {
	config_load doorfast
	config_get_bool enabled main enabled 0
	load_auto_elevator
	[ "$enabled" -eq 1 ] || return 0
	ensure_event_runtime || return 1
	rm -f /tmp/doorfast-pcm-http.state

	procd_open_instance
	procd_set_param command /usr/sbin/doorfast --config /etc/config/doorfast --call-elev "$call_elev"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger doorfast doorfast-automation
}
