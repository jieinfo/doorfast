#!/bin/sh /etc/rc.common

USE_PROCD=1
START=90

start_service() {
	config_load doorfast
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/doorfast --config /etc/config/doorfast
	procd_set_param respawn 3600 5 5
	procd_close_instance
}
