#!/bin/sh /etc/rc.common

USE_PROCD=1
START=90

EVENT_DIR=/var/run/doorfast
HOST_ADDRESS_STATE=${HOST_ADDRESS_STATE:-/var/run/doorfast/host-address}

host_identity_ip() {
	case "$1" in IS:*) ;; *) return 1 ;; esac
	old_ifs=$IFS
	set -f
	IFS=-
	set -- ${1#IS:}
	IFS=$old_ifs
	set +f
	[ "$#" -eq 4 ] || return 1
	for part in "$@"; do
		case "$part" in ''|*[!0-9]*) return 1 ;; esac
	done
	building=$1 unit=$2 room=$3 machine=$4
	floor=$((room / 100)) room_number=$((room % 100))
	[ "$building" -ge 1 ] && [ "$building" -le 99 ] || return 1
	[ "$unit" -ge 1 ] && [ "$unit" -le 9 ] || return 1
	[ "$floor" -ge 1 ] && [ "$floor" -le 63 ] || return 1
	[ "$room_number" -ge 1 ] && [ "$room_number" -le 32 ] || return 1
	[ "$machine" -ge 1 ] && [ "$machine" -le 4 ] || return 1
	building_unit=$((building * 10 + unit))
	printf '10.%d.%d.%d\n' "$((building_unit >> 2))" \
		"$(((building_unit & 3) << 6 | floor))" \
		"$(((machine - 1) << 5 | room_number - 1))"
}

host_netmask_prefix() {
	case "$1" in
		128.0.0.0) printf '1\n' ;;
		192.0.0.0) printf '2\n' ;;
		224.0.0.0) printf '3\n' ;;
		240.0.0.0) printf '4\n' ;;
		248.0.0.0) printf '5\n' ;;
		252.0.0.0) printf '6\n' ;;
		254.0.0.0) printf '7\n' ;;
		255.0.0.0) printf '8\n' ;;
		255.128.0.0) printf '9\n' ;;
		255.192.0.0) printf '10\n' ;;
		255.224.0.0) printf '11\n' ;;
		255.240.0.0) printf '12\n' ;;
		255.248.0.0) printf '13\n' ;;
		255.252.0.0) printf '14\n' ;;
		255.254.0.0) printf '15\n' ;;
		255.255.0.0) printf '16\n' ;;
		255.255.128.0) printf '17\n' ;;
		255.255.192.0) printf '18\n' ;;
		255.255.224.0) printf '19\n' ;;
		255.255.240.0) printf '20\n' ;;
		255.255.248.0) printf '21\n' ;;
		255.255.252.0) printf '22\n' ;;
		255.255.254.0) printf '23\n' ;;
		255.255.255.0) printf '24\n' ;;
		255.255.255.128) printf '25\n' ;;
		255.255.255.192) printf '26\n' ;;
		255.255.255.224) printf '27\n' ;;
		255.255.255.240) printf '28\n' ;;
		255.255.255.248) printf '29\n' ;;
		255.255.255.252) printf '30\n' ;;
		255.255.255.254) printf '31\n' ;;
		255.255.255.255) printf '32\n' ;;
		*) return 1 ;;
	esac
}

remove_host_address() {
	[ -r "$HOST_ADDRESS_STATE" ] || return 0
	read host_interface host_cidr extra <"$HOST_ADDRESS_STATE" || return 0
	case "$host_interface" in ''|*[!A-Za-z0-9_.:@-]*) return 1 ;; esac
	[ -z "$extra" ] || return 1
	ip address del "$host_cidr" dev "$host_interface" >/dev/null 2>&1 || true
	rm -f "$HOST_ADDRESS_STATE"
}

configure_host_address() {
	config_get_bool active_host main active_host 0
	[ "$active_host" -eq 1 ] || return 0
	config_get host_interface main host_interface
	if [ -z "$host_interface" ]; then
		config_get host_interface main gvs_interface
	fi
	config_get identity main gvs_local_address
	config_get indoor_ip main indoor_ipaddr
	config_get indoor_netmask main indoor_netmask
	[ -n "$host_interface" ] && [ -n "$indoor_netmask" ] || return 1
	case "$host_interface" in ''|*[!A-Za-z0-9_.:@-]*) return 1 ;; esac
	[ -n "$indoor_ip" ] || indoor_ip=$(host_identity_ip "$identity") || return 1
	prefix=$(host_netmask_prefix "$indoor_netmask") || return 1
	remove_host_address || return 1
	ip link set dev "$host_interface" up || return 1
	ip address add "$indoor_ip/$prefix" dev "$host_interface" || return 1
	printf '%s %s/%s\n' "$host_interface" "$indoor_ip" "$prefix" >"$HOST_ADDRESS_STATE"
}

migrate_mode_interfaces() {
	config_get legacy_interface main gvs_interface
	config_get passive_interface main passive_interface
	config_get host_interface main host_interface
	config_get_bool active_host main active_host 0
	[ -n "$legacy_interface" ] || return 0
	if [ "$active_host" -eq 1 ] && [ -z "$host_interface" ]; then
		uci -q set "doorfast.main.host_interface=$legacy_interface" || return 1
		uci -q commit doorfast || return 1
	elif [ "$active_host" -eq 0 ] && [ -z "$passive_interface" ]; then
		uci -q set "doorfast.main.passive_interface=$legacy_interface" || return 1
		uci -q commit doorfast || return 1
	fi
}

ensure_event_runtime() {
	# Keep this idempotent for restarts and package upgrades.
	if ! group_exists doorfast; then
		group_add_next doorfast >/dev/null
		group_exists doorfast || return 1
	fi
	mkdir -p "$EVENT_DIR" &&
		chown root:doorfast "$EVENT_DIR" &&
		chmod 0750 "$EVENT_DIR"
}

load_auto_elevator() {
	config_load doorfast-automation
	config_get call_elev main call_elev
	case "$call_elev" in
		0|1) return 0 ;;
	esac

	config_load doorfast
	config_get_bool call_elev main call_elev 0
	uci -q set "doorfast-automation.main.call_elev=$call_elev" &&
		uci -q commit doorfast-automation
}

start_service() {
	config_load doorfast
	migrate_mode_interfaces || return 1
	config_load doorfast
	config_get_bool enabled main enabled 0
	load_auto_elevator
	[ "$enabled" -eq 1 ] || return 0
	ensure_event_runtime || return 1
	configure_host_address || return 1
	rm -f /tmp/doorfast-pcm-http.state

	procd_open_instance
	procd_set_param command /usr/sbin/doorfast --config /etc/config/doorfast --call-elev "$call_elev"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

stop_service() {
	remove_host_address
}

service_triggers() {
	procd_add_reload_trigger doorfast doorfast-automation
}
